# Keep this file private once populated. Never commit .env to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set this to true when deployed behind HTTPS. 'auto' works for localhost.
INTERVIEWX_SECURE_COOKIES=auto
# Optional: specify a persistent database location on your server.
# INTERVIEWX_DB=interviewx.sqlite3

# Google Cloud Console -> OAuth 2.0 Client ID (Web application).
# Enable Gmail API and Google Calendar API; use exactly this callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/google/callback
# Required before Gmail/Calendar connection. Generate with:
# py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTERVIEWX_TOKEN_ENCRYPTION_KEY=
INTERVIEWX_TIMEZONE=Asia/Kolkata
